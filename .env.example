# サーバーポート（デフォルト: 3000）
PORT=3000

# LLM 各プロバイダの API キー。使う LLM の分だけ設定する。
# 設定 UI でチェックを入れた LLM のみ、対応するキーが必須になる。

# Anthropic (Claude) を使う場合
ANTHROPIC_API_KEY=

# OpenAI を使う場合
OPENAI_API_KEY=

# Google Gemini を使う場合
GEMINI_API_KEY=

# Ollama (ローカル LLM) は API キー不要。URL は設定 UI から変更可能。
# デフォルト: http://localhost:11434  →  OpenAI 互換 /v1/chat/completions を叩く
